[Unit]
Description=FileLinkBot Telegram Bot
After=network.target telegram-bot-api.service
Requires=telegram-bot-api.service

[Service]
Type=simple
EnvironmentFile=/opt/filelinkbot/.env
ExecStart=/opt/filelinkbot/venv/bin/python /opt/filelinkbot/bot/main.py
Restart=on-failure
RestartSec=5
User=YOUR_LINUX_USERNAME
WorkingDirectory=/opt/filelinkbot/bot

[Install]
WantedBy=multi-user.target
