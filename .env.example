# Copy this file to /opt/filelinkbot/.env and fill in real values.
# Do NOT commit this file with real secrets to any git repo.

# From @BotFather when you created your bot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# From https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Public base URL people will use to download files.
# No domain yet -> use http://YOUR_VPS_IP:8000
# Once you get a domain -> https://yourdomain.com
BASE_URL=http://YOUR_VPS_IP:8000

# Port the download web server listens on
WEB_PORT=8000

# Local Bot API server port (internal only, do not expose publicly)
LOCAL_API_PORT=8081

# Where files are stored on disk
STORAGE_DIR=/opt/filelinkbot/storage

# SQLite DB path
DB_PATH=/opt/filelinkbot/db/files.db

# Max upload size in MB (Local Bot API server supports up to 2000MB/2GB)
MAX_FILE_SIZE_MB=2000
